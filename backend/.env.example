PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_URL>/nibm_canteen_db?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret
BACKEND_URL=https://api.yourdomain.com
FRONTEND_URL=https://canteen.yourdomain.com
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_SECRET=your_merchant_secret_passphrase